<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="cgc_sign_masked_field.SignMaskedField">
        <div class="o_sign_masked_field_container">
            <input 
                t-attf-type="{{ inputType }}"
                t-attf-class="o_sign_masked_field_input {{ props.className or '' }}"
                t-att-value="state.value"
                t-on-input="onInput"
                placeholder="Enter masked value" autocomplete="off"
            />
            <button 
                type="button" 
                class="o_sign_masked_field_toggle" 
                t-on-click="toggleVisibility"
                title="Toggle visibility"
                tabindex="-1"
            >
                <i t-attf-class="fa {{ state.showValue ? 'fa-eye-slash' : 'fa-eye' }}"/>
            </button>
        </div>
    </t>

</templates>
